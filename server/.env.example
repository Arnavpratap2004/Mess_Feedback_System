# Copy to .env for local development. On Vercel, add these under
# Project Settings -> Environment Variables instead.

# Prisma Postgres connection string from the Prisma Console.
# Looks like: prisma+postgres://accelerate.prisma-data.net/?api_key=eyJ...
# A plain postgresql://user:pass@host:5432/db URL also works (uses @prisma/adapter-pg).
DATABASE_URL="prisma+postgres://accelerate.prisma-data.net/?api_key=YOUR_KEY_HERE"

# Signs the login tokens. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="replace-me-with-a-long-random-string"

# Comma-separated list of frontend origins allowed to call this API.
# Leave unset in development to allow any origin.
ALLOWED_ORIGINS="https://your-frontend.vercel.app"

# Timezone used for the "this week" / "this month" dashboard counts and for
# interpreting date filters.
REPORT_TIMEZONE="Asia/Kolkata"
