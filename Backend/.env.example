# Copy to .env for local development.
# On Vercel, set these under Project Settings -> Environment Variables instead.

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=root
DB_NAME=mess_feedback_system

# Set to "true" when your MySQL provider requires TLS (most cloud ones do).
DB_SSL=false

# Used to sign session cookies. Use a long random string in production.
SESSION_SECRET=change-me
